\u6982\u8ff0"},{"location":"deployment-doc/#_2","text":"","title":"\u90e8\u7f72\u6b65\u9aa4"},{"location":"deployment-doc/#1","text":"\u8bbf\u95ee JeecgBoot \u670d\u52a1\u5b9e\u4f8b\u521b\u5efa\u9875 \u3002","title":"1. \u6253\u5f00\u521b\u5efa\u9875\u9762"},{"location":"deployment-doc/#2","text":"\u53c2\u6570 \u8bf4\u660e \u5efa\u8bae \u670d\u52a1\u5b9e\u4f8b\u540d\u79f0 \u63a7\u5236\u53f0\u4e2d\u7528\u4e8e\u8bc6\u522b\u672c\u6b21\u90e8\u7f72 \u4fdd\u6301\u9ed8\u8ba4\u6216\u81ea\u5b9a\u4e49 \u5730\u57df\u4e0e\u53ef\u7528\u533a ECS \u6240\u5728\u4f4d\u7f6e \u9009\u62e9\u63a5\u8fd1\u4f7f\u7528\u8005\u4e14\u6709\u5e93\u5b58\u7684\u53ef\u7528\u533a \u4ed8\u8d39\u7c7b\u578b \u6309\u91cf\u4ed8\u8d39\u6216\u5305\u5e74\u5305\u6708 \u6d4b\u8bd5\u4f7f\u7528\u6309\u91cf\u4ed8\u8d39 \u5b9e\u4f8b\u7c7b\u578b ECS \u89c4\u683c \u6700\u4f4e\u53ef\u9009 4 vCPU / 16 GiB \u5b9e\u4f8b\u5bc6\u7801 ECS \u767b\u5f55\u5bc6\u7801 \u4f7f\u7528\u7b26\u5408\u9875\u9762\u89c4\u5219\u7684\u5f3a\u5bc6\u7801 \u7ba1\u7406\u5458\u767b\u5f55\u5bc6\u7801 admin \u8d26\u53f7\u9996\u6b21\u767b\u5f55\u5bc6\u7801 \u4f7f\u7528\u4e0d\u540c\u4e8e ECS \u5bc6\u7801\u7684\u5f3a\u5bc6\u7801 \u524d\u7aef\u8bbf\u95ee\u5730\u5740 \u81ea\u5b9a\u4e49\u57df\u540d\u6216 URL \u53ef\u7559\u7a7a\uff0c\u81ea\u52a8\u4f7f\u7528\u5b9e\u4f8b\u516c\u7f51 IP AI \u5927\u6a21\u578b API Key \u542f\u7528 AI \u52a9\u624b\u65f6\u4f7f\u7528 \u53ef\u7559\u7a7a\uff1b\u4e0d\u8981\u586b\u5199\u5230\u975e\u53ef\u4fe1\u73af\u5883 AI \u63a5\u53e3\u5730\u5740 OpenAI \u517c\u5bb9\u63a5\u53e3 \u9ed8\u8ba4\u4f7f\u7528\u963f\u91cc\u4e91\u767e\u70bc\u517c\u5bb9\u5730\u5740 AI \u6a21\u578b\u540d\u79f0 AI \u52a9\u624b\u8c03\u7528\u7684\u6a21\u578b \u9ed8\u8ba4 qwen-plus \u4e13\u6709\u7f51\u7edc \u65b0\u5efa\u6216\u590d\u7528 VPC \u9996\u6b21\u90e8\u7f72\u53ef\u9009\u62e9\u65b0\u5efa \u586b\u5199\u5b8c\u6210\u5e76\u770b\u5230\u8be2\u4ef7\u7ed3\u679c\u540e\uff0c\u70b9\u51fb\u201c\u4e0b\u4e00\u6b65\uff1a\u786e\u8ba4\u8ba2\u5355\u201d\uff0c\u6838\u5bf9\u8d44\u6e90\u548c\u8d39\u7528\uff0c\u52fe\u9009\u670d\u52a1\u534f\u8bae\u5e76\u521b\u5efa\u5b9e\u4f8b\u3002","title":"2. \u914d\u7f6e\u90e8\u7f72\u53c2\u6570"},{"location":"deployment-doc/#3","text":"\u8fdb\u5165\u670d\u52a1\u5b9e\u4f8b\u8be6\u60c5\u9875\uff0c\u7b49\u5f85\u72b6\u6001\u53d8\u4e3a\u201c\u5df2\u90e8\u7f72\u201d\u3002\u672c\u6b21\u5b9e\u6d4b\u4ece\u521b\u5efa\u5230\u90e8\u7f72\u5b8c\u6210\u7ea6 134 \u79d2\u3002 \u201c\u7acb\u5373\u4f7f\u7528\u201d\u533a\u57df\u4f1a\u663e\u793a\uff1a jeecgboot_80_url \uff1aJeecgBoot \u8bbf\u95ee\u5730\u5740\uff1b QuickStartGuide \uff1a\u9996\u6b21\u767b\u5f55\u8bf4\u660e\uff1b AdminUsername \uff1a\u7ba1\u7406\u5458\u7528\u6237\u540d\uff1b ApiDocPath \uff1aKnife4j \u63a5\u53e3\u6587\u6863\u8def\u5f84\u3002","title":"3. \u7b49\u5f85\u90e8\u7f72\u5b8c\u6210"},{"location":"deployment-doc/#_3","text":"\u6253\u5f00 jeecgboot_80_url \uff0c\u4f7f\u7528\u7528\u6237\u540d admin \u548c\u90e8\u7f72\u65f6\u8bbe\u7f6e\u7684\u7ba1\u7406\u5458\u767b\u5f55\u5bc6\u7801\u767b\u5f55\u3002\u9996\u6b21\u8bbf\u95ee\u65f6\u5982\u6570\u636e\u5e93\u4ecd\u5728\u521d\u59cb\u5316\uff0c\u8bf7\u7b49\u5f85\u6570\u5206\u949f\u540e\u91cd\u8bd5\u3002 \u767b\u5f55\u540e\u53ef\u8fdb\u5165\u201c\u4f4e\u4ee3\u7801\u5f00\u53d1 \u2192 Online \u8868\u5355\u5f00\u53d1\u201d\u521b\u5efa\u4e1a\u52a1\u8868\u3002\u53d1\u5e03\u524d\u5b9e\u6d4b\u521b\u5efa\u4e86\u5305\u542b\u9879\u76ee\u540d\u79f0\u548c\u9879\u76ee\u72b6\u6001\u5b57\u6bb5\u7684\u8868\u5355\uff0c\u5e76\u6267\u884c\u666e\u901a\u540c\u6b65\uff1b\u5237\u65b0\u9875\u9762\u540e\u8868\u5355\u4ecd\u5b58\u5728\u4e14\u72b6\u6001\u4fdd\u6301\u201c\u5df2\u540c\u6b65\u201d\u3002 Knife4j \u63a5\u53e3\u6587\u6863\u4f4d\u4e8e\u8bbf\u95ee\u5730\u5740\u540e\u7684 /jeecgboot/doc.html \u3002","title":"\u9996\u6b21\u8bbf\u95ee\u4e0e\u4f7f\u7528"},{"location":"deployment-doc/#_4","text":"\u9a8c\u8bc1\u9879 \u7ed3\u679c \u670d\u52a1\u5b9e\u4f8b \u72b6\u6001\u4e3a\u201c\u5df2\u90e8\u7f72\u201d \u5e94\u7528\u8bbf\u95ee \u767b\u5f55\u9875\u548c\u7ba1\u7406\u540e\u53f0\u6b63\u5e38\u52a0\u8f7d \u8eab\u4efd\u8ba4\u8bc1 \u4f7f\u7528\u90e8\u7f72\u65f6\u8bbe\u7f6e\u7684\u7ba1\u7406\u5458\u5bc6\u7801\u6210\u529f\u767b\u5f55 Online \u8868\u5355 \u6210\u529f\u521b\u5efa cn_project_tracker \u8868\u5355 \u6570\u636e\u5e93\u540c\u6b65 \u666e\u901a\u540c\u6b65\u6210\u529f\uff0c\u72b6\u6001\u53d8\u4e3a\u201c\u5df2\u540c\u6b65\u201d \u6570\u636e\u6301\u4e45\u5316 \u5237\u65b0\u9875\u9762\u540e\u8868\u5355\u548c\u540c\u6b65\u72b6\u6001\u4ecd\u5b58\u5728","title":"\u53ef\u7528\u6027\u9a8c\u8bc1"},{"location":"deployment-doc/#_5","text":"JeecgBoot\u3001MySQL\u3001Redis \u548c pgvector \u5747\u8fd0\u884c\u5728\u7528\u6237\u81ea\u5df1\u7684 ECS \u4e2d\u3002 \u90e8\u7f72\u53c2\u6570\u6587\u4ef6\u4f4d\u4e8e /opt/jeecgboot/params \uff0c\u5bc6\u7801\u548c API Key \u6587\u4ef6\u5177\u6709\u53d7\u9650\u6743\u9650\uff1b\u4e0d\u8981\u590d\u5236\u3001\u4e0a\u4f20\u6216\u63d0\u4ea4\u8fd9\u4e9b\u6587\u4ef6\u3002 \u9ed8\u8ba4\u901a\u8fc7\u516c\u7f51 HTTP 80 \u7aef\u53e3\u8bbf\u95ee\u3002\u751f\u4ea7\u73af\u5883\u5efa\u8bae\u9650\u5236\u5b89\u5168\u7ec4\u6765\u6e90\uff0c\u5e76\u4e3a\u81ea\u5b9a\u4e49\u57df\u540d\u914d\u7f6e HTTPS\u3002 AI API Key \u4e3a\u53ef\u9009\u9879\uff1b\u4e0d\u4f7f\u7528 AI \u52a9\u624b\u65f6\u4fdd\u6301\u4e3a\u7a7a\u3002 \u5220\u9664\u670d\u52a1\u5b9e\u4f8b\u4f1a\u540c\u65f6\u5220\u9664 ECS \u53ca\u5176\u672c\u5730\u6570\u636e\uff0c\u91ca\u653e\u524d\u8bf7\u5148\u5b8c\u6210\u6570\u636e\u5e93\u548c\u9644\u4ef6\u5907\u4efd\u3002","title":"\u6570\u636e\u4e0e\u5b89\u5168"},{"location":"deployment-doc/#_6","text":"\u4e0d\u518d\u4f7f\u7528\u65f6\uff0c\u5728\u8ba1\u7b97\u5de2\u670d\u52a1\u5b9e\u4f8b\u8be6\u60c5\u9875\u6267\u884c\u201c\u5220\u9664\u201d\u3002\u5220\u9664\u5b8c\u6210\u540e\u5efa\u8bae\u7ee7\u7eed\u786e\u8ba4\uff1a \u670d\u52a1\u5b9e\u4f8b\u5df2\u4e0d\u5b58\u5728\uff1b ROS \u8d44\u6e90\u6808\u72b6\u6001\u4e3a DELETE_COMPLETE \uff1b ECS\u3001VPC\u3001\u4ea4\u6362\u673a\u548c\u5b89\u5168\u7ec