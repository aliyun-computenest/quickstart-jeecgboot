u949f\u540e\u91cd\u8bd5\u3002 \u767b\u5f55\u540e\u53ef\u8fdb\u5165\u201c\u4f4e\u4ee3\u7801\u5f00\u53d1 \u2192 Online \u8868\u5355\u5f00\u53d1\u201d\u521b\u5efa\u4e1a\u52a1\u8868\u3002\u53d1\u5e03\u524d\u5b9e\u6d4b\u521b\u5efa\u4e86\u5305\u542b\u9879\u76ee\u540d\u79f0\u548c\u9879\u76ee\u72b6\u6001\u5b57\u6bb5\u7684\u8868\u5355\uff0c\u5e76\u6267\u884c\u666e\u901a\u540c\u6b65\uff1b\u5237\u65b0\u9875\u9762\u540e\u8868\u5355\u4ecd\u5b58\u5728\u4e14\u72b6\u6001\u4fdd\u6301\u201c\u5df2\u540c\u6b65\u201d\u3002 Knife4j \u63a5\u53e3\u6587\u6863\u4f4d\u4e8e\u8bbf\u95ee\u5730\u5740\u540e\u7684 /jeecgboot/doc.html \u3002 \u53ef\u7528\u6027\u9a8c\u8bc1 \u9a8c\u8bc1\u9879 \u7ed3\u679c \u670d\u52a1\u5b9e\u4f8b \u72b6\u6001\u4e3a\u201c\u5df2\u90e8\u7f72\u201d \u5e94\u7528\u8bbf\u95ee \u767b\u5f55\u9875\u548c\u7ba1\u7406\u540e\u53f0\u6b63\u5e38\u52a0\u8f7d \u8eab\u4efd\u8ba4\u8bc1 \u4f7f\u7528\u90e8\u7f72\u65f6\u8bbe\u7f6e\u7684\u7ba1\u7406\u5458\u5bc6\u7801\u6210\u529f\u767b\u5f55 Online \u8868\u5355 \u6210\u529f\u521b\u5efa cn_project_tracker \u8868\u5355 \u6570\u636e\u5e93\u540c\u6b65 \u666e\u901a\u540c\u6b65\u6210\u529f\uff0c\u72b6\u6001\u53d8\u4e3a\u201c\u5df2\u540c\u6b65\u201d \u6570\u636e\u6301\u4e45\u5316 \u5237\u65b0\u9875\u9762\u540e\u8868\u5355\u548c\u540c\u6b65\u72b6\u6001\u4ecd\u5b58\u5728 \u6570\u636e\u4e0e\u5b89\u5168 JeecgBoot\u3001MySQL\u3001Redis \u548c pgvector \u5747\u8fd0\u884c\u5728\u7528\u6237\u81ea\u5df1\u7684 ECS \u4e2d\u3002 \u90e8\u7f72\u53c2\u6570\u6587\u4ef6\u4f4d\u4e8e /opt/jeecgboot/params \uff0c\u5bc6\u7801\u548c API Key \u6587\u4ef6\u5177\u6709\u53d7\u9650\u6743\u9650\uff1b\u4e0d\u8981\u590d\u5236\u3001\u4e0a\u4f20\u6216\u63d0\u4ea4\u8fd9\u4e9b\u6587\u4ef6\u3002 \u9ed8\u8ba4\u901a\u8fc7\u516c\u7f51 HTTP 80 \u7aef\u53e3\u8bbf\u95ee\u3002\u751f\u4ea7\u73af\u5883\u5efa\u8bae\u9650\u5236\u5b89\u5168\u7ec4\u6765\u6e90\uff0c\u5e76\u4e3a\u81ea\u5b9a\u4e49\u57df\u540d\u914d\u7f6e HTTPS\u3002 AI API Key \u4e3a\u53ef\u9009\u9879\uff1b\u4e0d\u4f7f\u7528 AI \u52a